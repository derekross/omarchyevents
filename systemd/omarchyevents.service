[Unit]
Description=Omarchy Events: mirror the Omarchy Meetups Luma calendar to Nostr
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/omarchyevents
ExecStart=%h/projects/omarchyevents/.venv/bin/python omarchybot.py sync
StandardOutput=journal
StandardError=journal
